name: Flutter CI - Real and Mock Versions

on:
  push:
    branches: ['**']
  pull_request:
    branches: ['**']

jobs:
  build:
    strategy:
      matrix:
        version: [real, mock]
        include:
          - version: real
            backend_type: real
            apk_suffix: real
            display_name: "Real Backend"
          - version: mock
            backend_type: mock
            apk_suffix: mock
            display_name: "Mock Backend"

    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Set up Java
        uses: actions/setup-java@v5
        with:
          distribution: "temurin"
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Install dependencies
        run: flutter pub get

      - name: Analyze code
        run: flutter analyze

      - name: Run tests
        run: flutter test

      - name: Build ${{ matrix.display_name }} APK
        run: |
          if [ "${{ matrix.version }}" = "mock" ]; then
            flutter build apk --release --target-platform=android-arm64 --dart-define=BACKEND_TYPE=mock
          else
            flutter build apk --release --target-platform=android-arm64 --dart-define=BACKEND_TYPE=real
          fi

      - name: Rename APK for ${{ matrix.display_name }}
        run: |
          if [ "${{ matrix.version }}" = "mock" ]; then
            mv build/app/outputs/flutter-apk/app-release.apk build/app/outputs/flutter-apk/app-mock-release.apk
          else
            mv build/app/outputs/flutter-apk/app-release.apk build/app/outputs/flutter-apk/app-real-release.apk
          fi

      - name: Upload ${{ matrix.display_name }} APK
        uses: actions/upload-artifact@v5
        with:
          name: app-${{ matrix.apk_suffix }}-release
          path: build/app/outputs/flutter-apk/app-${{ matrix.apk_suffix }}-release.apk